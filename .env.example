# Required for content generation
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash-vision-exp

# Optional: any OpenAI-compatible speech-to-text endpoint.
# DeepSeek does not currently provide audio transcription, so this is separate.
STT_API_KEY=
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1

DATABASE_PATH=./data/thoughts.db
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_URL=http://localhost:8000

